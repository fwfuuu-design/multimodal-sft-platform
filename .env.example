# API runtime paths
MVP_DATABASE_PATH=/var/lib/sft-platform/service.sqlite3
MVP_STATE_ROOT=/var/lib/sft-platform/state
MVP_MODEL_ROOTS=/models
MVP_DATA_ROOTS=/data
MVP_MEDIA_ROOTS=/media
MVP_RESULTS_ROOT=/results

# Security and integration factories
# Generate the Fernet key through your secret-management workflow.
MVP_FERNET_KEY=
MVP_TOKEN_VERIFIER_FACTORY=your_package.auth:create_token_verifier
MVP_HUB_INSPECTOR_FACTORY=your_package.hub:create_hub_inspector
MVP_MODEL_ADAPTER_FACTORY=your_package.model:create_model_adapter

# API listener
MVP_API_HOST=127.0.0.1
MVP_API_PORT=8000

# Initial project bootstrap
MVP_BOOTSTRAP_PROJECT_NAME=Default Project
MVP_BOOTSTRAP_ADMIN_SUBJECT=
MVP_BOOTSTRAP_ADMIN_DISPLAY_NAME=
